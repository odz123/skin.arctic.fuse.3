<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="Action_BuildViews">
        <description>Is set in script-skinviewtypes-includes.xml to rebuild viewtypes on update and then not again because it will then overwrite the file. Includes file set to not track in github so that it always is blank with just the include to trigger refresh.</description>
    </include>

    <include name="skinvariables-powertray-onload">
        <description>Generated include to check if tray menu is visible will override</description>
        <onload>Skin.SetBool(Options.DisableBottomTray)</onload>
    </include>

    <!-- Fallback stubs for search widget includes generated by script.skinvariables.
         On first skin activation the script hasn't run yet, so these prevent crashes
         from undefined include references. script.skinvariables will override these. -->
    <include name="skinvariables-searchwidgets-combined" />
    <include name="skinvariables-searchwidgets-standard" />
    <include name="skinvariables-searchwidgets-info" />
    <include name="skinvariables-searchwidgets-selector" />

